{
  "name": "@elementspanel/epanel-plugin-mc-tools",
  "version": "0.1.3",
  "description": "一些适用于 Minecraft 服务器的额外小工具。",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "panel/plugin.json",
    "panel/backend/",
    "panel/frontend/",
    "daemon/plugin.json",
    "daemon/backend/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^4.2.0",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "esbuild": "^0.18.20",
    "vite": "^4.5.14",
    "vue": "^3.5.42",
    "vuetify": "^4.2.1"
  },
  "peerDependencies": {
    "@elementspanel/daemon": "^1.0.7",
    "@elementspanel/panel": "^1.0.9"
  },
  "peerDependenciesMeta": {
    "@elementspanel/panel": {
      "optional": true
    },
    "@elementspanel/daemon": {
      "optional": true
    }
  },
  "elementspanel": {
    "id": "mc-tools",
    "dual": true,
    "panel": {
      "directory": "panel",
      "folder": "mc-tools",
      "frontendInject": [
        "console",
        "i18n",
        "instance"
      ],
      "styles": [
        "frontend/assets/frontend-ecfc8673.css"
      ]
    },
    "daemon": {
      "directory": "daemon",
      "folder": "mc-tools"
    }
  },
  "dependencies": {
    "leveldb-zlib": "^1.2.1",
    "prismarine-nbt": "^2.8.0",
    "three": "^0.187.0"
  },
  "displayName": "MC Tools"
}
